# Database
DATABASE_URL=postgresql+asyncpg://strategy_lab:strategy_lab@localhost:5432/strategy_lab
DATABASE_URL_SYNC=postgresql://strategy_lab:strategy_lab@localhost:5432/strategy_lab
POSTGRES_USER=strategy_lab
POSTGRES_PASSWORD=strategy_lab
POSTGRES_DB=strategy_lab

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible for Parquet files)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-data
MINIO_SECURE=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# MCP
MCP_SERVER_NAME=strategy-lab
MCP_SERVER_VERSION=0.1.0

# Security
SECRET_KEY=change-in-production-use-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development
DEBUG=true
LOG_LEVEL=INFO

# pgAdmin
PGADMIN_EMAIL=admin@strategy-lab.com
PGADMIN_PASSWORD=admin